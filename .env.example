# Copy this file to .env for local development (Render sets these for you
# automatically in production — you'll paste them into Render's dashboard
# instead, see README.md).

# Your service account's JSON key file, base64-encoded onto a single line.
# See README.md Step 4 for the exact command to generate this.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# The ID of the Drive folder you shared with the service account (the part
# of the folder's URL after /folders/).
GOOGLE_DRIVE_FOLDER_ID=
